# OmniReach — Voice Backend · Environment Variables
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Default voice provider: elevenlabs (primary) or retell (fallback).
# A profile can override this per-agent via its voice.provider field.
VOICE_PROVIDER=elevenlabs

# ── ElevenLabs (primary) ──
# Create ONE Conversational AI agent, connect a Twilio number (that gives you the phone number
# id, which starts with phnum_, not the number itself), then ENABLE per-call overrides
# (system prompt, first message, language, voice, LLM, TTS) in the agent's Security tab
# AND PUBLISH the agent. Toggling them in an unpublished draft is the #1 cause of
# "Override for field X is not allowed by config" on live calls.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Send stability/speed/similarity as per-call overrides. The app auto-detects which overrides
# your agent actually allows and drops the rest, so this is safe on. Set to false to always
# use the agent's own voice settings.
ELEVENLABS_SEND_VOICE_TUNING=true

# ── Retell (fallback) ──
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Company Profile to load on startup (a preset id from ../../config/presets, no .json).
# Only used on a first run; after that the active profile is whatever is stored.
ACTIVE_PROFILE=banking-india

# Server
PORT=3002

# Bulk call delay in seconds (default 3)
BULK_DELAY_SECONDS=3

# Public base URL where THIS backend is reachable from the internet (no trailing slash).
# ElevenLabs calls the action-tool webhooks from the cloud, so localhost will not work —
# use a tunnel (`ngrok http 3002`) or your deployed URL. Leave blank for local-only use.
# Example: https://abc123.ngrok.app
PUBLIC_BASE=

# Optional shared secret guarding the action-tool webhook. Set it and the tool sync adds the
# matching `x-tool-secret` header to all 14 tools automatically.
TOOL_WEBHOOK_SECRET=

# On boot, register the 14 action tools in ElevenLabs and attach them to the agent, using
# PUBLIC_BASE for their webhook URLs. Idempotent, so a restart is a no-op once they are correct.
# Set to false ONLY if a second instance (e.g. staging) shares this ElevenLabs workspace, or the
# two will keep rewriting each other's webhook URLs.
AUTO_SYNC_TOOLS=true

# ── Post-call webhook (strongly recommended) ──
# In the ElevenLabs dashboard, add a post-call webhook pointing at:
#     <PUBLIC_BASE>/api/elevenlabs/webhook
# ElevenLabs then pushes each finished conversation — transcript, summary, success evaluation and
# extracted fields — the moment the call ends, instead of us polling for it. Paste the signing
# secret it gives you here so the signature is verified. Leave blank only for local testing.
ELEVENLABS_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# MULTI-USER / DEPLOYMENT
# Leave all of this blank for local use. It matters once the console is on a
# public HTTPS URL that partners log in to. See docs/DEPLOYMENT.md.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (strongly recommended before going live) ──
# Without this, users/calls/profiles live in JSON files under data/ — and most hosts
# (Render, Railway, Fly) wipe the filesystem on every deploy, so accounts vanish.
# Use a MANAGED Postgres: you do not run a server, the provider hosts it 24/7 and
# gives you this one string. Free tiers: neon.tech, supabase.com, railway.app.
# After setting it, run once:  npm run migrate      (copies data/*.json into Postgres)
DATABASE_URL=
# Only if your provider uses a private CA that isn't in the system trust store.
# Leave false — true disables certificate verification.
DATABASE_SSL_INSECURE=false

# ── Session signing key (set this in production) ──
# Signs login tokens. If blank, a random key is generated into data/auth-secret, which
# means every redeploy signs everyone out, and two instances reject each other's logins.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Set to true ONLY when this runs behind a load balancer or reverse proxy (Render, Railway, Azure,
# nginx). It makes Express read the real client IP from X-Forwarded-For, which the per-IP sign-in
# limits and the region on an access request both depend on. Leave false when running directly:
# trusting that header with no proxy in front lets anyone forge their IP.
TRUST_PROXY=false

# ── Who owns the platform ──
# The email domain of the operator, i.e. Streebo. It decides which admins see EVERY partner's calls,
# settings and analytics, and which are confined to their own company. Left blank the server infers
# it (the super administrator's org, else the oldest admin account) and prints what it inferred at
# boot — but on a hosted instance set it explicitly, because everything about who can see whose data
# hangs off this one value.
PLATFORM_ORG=streebo.com

# ── The daily activity report ──
# One email a day to Streebo covering every partner. There is nothing to configure here: the
# schedule, the timezone and the recipients live in the database and are edited by a super
# administrator under Admin → Daily report. It does need MAIL_PROVIDER=graph to actually send.

# ── Outbound email (sign-in codes and the daily report) ──
# graph = Microsoft 365 via the Graph API (production), smtp = any relay via nodemailer,
# dev = print the message to the server log and send nothing (local development).
# Leave as dev until the credential below is in place. Verify with:  npm run mail:test
MAIL_PROVIDER=dev
#
# From the Entra app registration IT provisions. Three values, and one common trap:
# GRAPH_CLIENT_SECRET must be the secret's *Value*, NOT its *Secret ID*. The Value is shown
# only once, at creation. A Secret ID is a GUID; a Value never is.
# The portal's "Object ID" is not used at all.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The single mailbox the app registration is scoped to send as.
GRAPH_MAIL_FROM=notification@streebo.com
#
# Only for MAIL_PROVIDER=smtp. Needs `npm install nodemailer` (not a dependency by default).
# URL-encode the @ in the username as %40. SMTP_FROM is the envelope sender when GRAPH_MAIL_FROM
# is not set; with Graph it is ignored.
SMTP_URL=
SMTP_FROM=

# ── First admin account (created only on a completely empty database) ──
# If ADMIN_PASSWORD is blank, a strong random password is generated and printed ONCE
# in the startup log. Either way the account must set a new password at first sign-in.
ADMIN_EMAIL=admin@streebo.com
ADMIN_PASSWORD=
